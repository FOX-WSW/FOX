# Copy to .env locally. Never commit populated secret values.
PROJECT_BOT_ROOT=
BOT_APPROVED_STATE_ROOT=./data
BOT_ALLOWED_CHAT_IDS=
BOT_DRY_RUN=true
BOT_ALLOW_REAL_WRITES=false
BOT_SCAFFOLD_ONLY=true
BOT_FEISHU_IDENTITY_VERIFIED=false
BOT_EVENT_SUBSCRIPTION_VERIFIED=false
BOT_CODEX_ADAPTER_READY=false
BOT_REQUIRED_CONNECTORS_READY=false
BOT_STATE_PATH=./data/state.sqlite3
BOT_CODEX_COMMAND=codex
BOT_MAX_TOPIC_CONCURRENCY=4
BOT_QUERY_TIMEOUT_SECONDS=30
BOT_QUERY_ROW_LIMIT=500

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Add DSN/user/password variables named by config/bot.example.json.
# Values belong in the local secret facility, not this file.
__DATABASE_ENV_LINES__
LOG_PROVIDER_TOKEN=
