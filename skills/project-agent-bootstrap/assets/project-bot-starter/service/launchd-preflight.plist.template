<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.__BOT_SLUG__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_ROOT__/.venv/bin/python</string>
    <string>-m</string>
    <string>__PACKAGE_NAME__</string>
    <string>preflight</string>
    <string>--live</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__INSTALL_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__INSTALL_ROOT__/logs/preflight-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_ROOT__/logs/preflight-stderr.log</string>
</dict>
</plist>
